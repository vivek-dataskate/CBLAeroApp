{
  "permissions": {
    "allow": [
      "mcp__render__list_logs",
      "mcp__render__list_services",
      "mcp__render__list_deploys",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(git *)",
      "Bash(git diff *)",
      "Bash(git checkout *)",
      "Bash(git apply *)",
      "Bash(git status *)",
      "Bash(rm *)",
      "Bash(chmod *)",
      "Bash(printf *)",
      "Bash(kill *)",
      "Bash(gh *)",
      "Bash(mkdir *)",
      "Edit(.claude/**)",
      "Edit(/home/node/.claude/**)",
      "Edit(~/.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "jq -r '.tool_input.command' | grep -qE 'git\\s+push\\s+.*master' && echo '{\"decision\":\"block\",\"reason\":\"Direct push to master is blocked. Use /push to create a branch, open a PR, merge, and clean up.\"}' || echo '{\"continue\":true}'",
            "statusMessage": "Checking push target..."
          }
        ]
      }
    ]
  }
}
