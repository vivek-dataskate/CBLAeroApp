Thumbs.db
ehthumbs.db
Desktop.ini

# dist output
/dist

# BMAD framework installation (workflow engine, agents, configs)
_bmad/
_bmad-core/

# BMAD project artifacts (PRD, stories, architecture, sprint tracking)
_bmad-output/

# Claude / Cowork session data and skills
.claude/

# Project management docs (contain business/product details)
PROJECT_STATUS.md

# VS Code local workspace settings (tasks are personal)
.vscode/

