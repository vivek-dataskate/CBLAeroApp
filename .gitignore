# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
tests/e2e/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local dev
.supabase/
supabase/.temp/

# local files
*.local

# os artifacts
Thumbs.db
ehthumbs.db
Desktop.ini

# dist output
/dist

# BMAD framework installation (workflow engine, agents, configs)
_bmad/
_bmad-core/

# BMAD project artifacts (PRD, stories, architecture, sprint tracking) — committed to git

# Claude / Cowork — ignore ephemeral data, keep settings + skills + commands
.claude/*
!.claude/settings.json
!.claude/commands/
!.claude/skills/


# Project management docs (contain business/product details)
PROJECT_STATUS.md

# VS Code local workspace settings (tasks are personal)
.vscode/
# Exception: MCP server configuration should be committed
!.vscode/mcp.json

# BMAD temporary work files (generated during workflow execution)
tech-spec-wip.md
deferred-work.md
review-prompt-*.md
**/ux-color-themes.html
**/ux-design-directions.html

# BMAD viewer
.bmad-viewer/

# GitHub Actions (not used — only ignore workflows folder, not instructions/skills)
.github/workflows/
# Custom instructions and skills are committed
# (no negation needed — parent dir is not blanket-ignored)

# Docs generated by BMAD
docs/

package-lock.json
.backup-env
.backup-env
